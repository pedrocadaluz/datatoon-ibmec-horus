    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "lighthouse": "13.6.0",
    "sharp": "0.35.5",
